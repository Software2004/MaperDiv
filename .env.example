# Copy to `.env` (or `.env.local`) and fill in. All are optional — the site
# builds and runs with the defaults baked into src/siteConfig.js.

# Canonical site origin. Used for <link rel="canonical">, Open Graph URLs,
# JSON-LD and the generated sitemap.xml / robots.txt. No trailing slash.
VITE_SITE_URL=https://www.mappirdev.com

# Contact / quote form endpoint. Any backend that accepts a JSON POST and
# returns 2xx works: Formspree (https://formspree.io/f/xxxx);
# Basin (https://usebasin.com/f/xxxxx); Web3Forms; or your own function / CRM.
# Leave empty to fall back to a mailto: link.
VITE_CONTACT_ENDPOINT=

# GitHub Pages project-page deploy only (user.github.io/<repo>/). Also set
# segmentsToKeep = 1 in public/404.html. Leave unset for a custom domain.
# VITE_BASE=/MaperDiv/
